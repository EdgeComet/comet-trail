{
  "name": "comet-trail",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Evergreen crawl for your own site. Monorepo: worker/ records search and AI bot visits with the page each received into D1; dashboard/ reports on them.",
  "workspaces": [
    "worker",
    "dashboard"
  ],
  "scripts": {
    "setup": "node scripts/ct-install.mjs",
    "deploy:worker": "npm -w worker run deploy",
    "deploy:dashboard": "npm -w dashboard run deploy",
    "db:init": "npm -w worker run db:init",
    "db:recent": "npm -w worker run db:recent",
    "tail": "npm -w worker run tail"
  }
}
